rules_version = '2';

// Security model:
// - Every collection requires a signed-in Firebase Auth user (see context/AuthContext.tsx).
// - Role ('admin' | 'vendedora' | 'operador' | 'especialista') and department
//   ('bazar' | 'taller') are read from Firebase Auth custom claims, set only by
//   the Admin SDK (see scripts/seedUsers.ts) — clients can never set their own
//   claims, so a compromised client cannot grant itself admin access.
// - Departments are kept isolated (bazar vs taller), mirroring the strict
//   separation already enforced in the UI (components/RoleBasedRouter.tsx).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function department() {
      return request.auth.token.department;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    // Admins can act across both departments; everyone else is scoped to their own.
    function inDepartment(dept) {
      return isSignedIn() && (isAdmin() || department() == dept);
    }

    // --- Bazar (POS) operational data ---
    match /sales/{saleId} {
      allow read, create: if inDepartment('bazar');
      allow update, delete: if isAdmin();
    }

    // --- Taller (workshop) operational data ---
    match /work_orders/{workOrderId} {
      allow read, create: if inDepartment('taller');
      allow update, delete: if isAdmin();
    }

    // --- Shared audit trail: write-once from the client, never edited or deleted ---
    match /logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // --- HR attendance: any signed-in employee can clock in/out; only admins amend ---
    match /attendance/{recordId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --- Payroll: sensitive salary data, admins only ---
    match /payrollRecords/{recordId} {
      allow read, write: if isAdmin();
    }
    match /employeeProfiles/{profileId} {
      allow read, write: if isAdmin();
    }

    // Default deny for anything not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
